# ─── Pimland AI Reporting — Environment Template ────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# In production, inject these via AWS Secrets Manager / SSM Parameter Store.

# --- App ---
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_NAME="Pimland AI Reporting"
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL (AWS RDS) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pimland
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pimland_reporting
# Optional read-only role used to EXECUTE LLM-generated SQL (defense in depth).
POSTGRES_READONLY_USER=pimland_ro
POSTGRES_READONLY_PASSWORD=change_me

# --- Redis (AWS ElastiCache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=3600

# --- LLM (AWS Bedrock — Anthropic API key gerekmez) ---
# Model ID listesi: https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# --- AWS (Bedrock + S3) ---
AWS_REGION=eu-central-1
S3_BUCKET=pimland-reporting-artifacts
# Yerel geliştirme için explicit credentials; production'da boş bırak (instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SQL guard ---
SQL_MAX_LIMIT=10000                 # hard row cap injected into generated SQL
SQL_STATEMENT_TIMEOUT_MS=15000      # per-query Postgres statement_timeout

# --- adL Premium Brief v2 ---
BEDROCK_COMPOSER_MODEL=arn:aws:bedrock:eu-north-1:448049806345:inference-profile/eu.anthropic.claude-sonnet-4-6
BRIEF_BUCKET=pimland-reporting-artifacts   # S3 bucket for brief HTML output
BRIEF_PREFIX=briefs                        # s3://{BRIEF_BUCKET}/{BRIEF_PREFIX}/{tarih}/{EC|MG}.html
